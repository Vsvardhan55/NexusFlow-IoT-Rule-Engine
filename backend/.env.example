PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nexusflow
CLIENT_ORIGIN=http://localhost:5173
MONGO_MAX_POOL_SIZE=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
NODE_ENV=development

# Number of recent samples used by the live RxJS moving-average stream
MOVING_AVERAGE_WINDOW=10

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local telemetry simulator defaults
SIMULATOR_API_URL=http://localhost:5000
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_DEVICE_ID=turbine-01
